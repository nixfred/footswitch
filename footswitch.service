[Unit]
Description=Stream Deck Pedal to Omarchy actions
Documentation=file:///home/pi/Projects/footswitch/README.md
# Deliberately NOT Wants/After=graphical-session.target: a user unit that wants
# it races uwsm at login and can leave the session with no GUI at all.

[Service]
Type=simple
ExecStart=/home/pi/Projects/footswitch/footswitch
# The daemon waits for the pedal itself rather than exiting when it is absent,
# so a restart here only matters if it genuinely crashes.
Restart=on-failure
RestartSec=10
StartLimitBurst=0

[Install]
WantedBy=default.target
